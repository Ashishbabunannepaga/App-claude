# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Production values come from a secrets manager.
ENV=development
DATABASE_URL=postgresql+psycopg://insure:insure@localhost:5432/insure
REDIS_URL=redis://localhost:6379/0
TASKS_EAGER=true

JWT_SECRET=change-me-to-a-long-random-string
OTP_HMAC_SECRET=change-me-too
OTP_SENDER=console

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=        # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via environment or IAM role

# AI: mock | gemini | claude | openai   (mock = offline heuristics, development only)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
EMBEDDING_PROVIDER=hashing   # hashing (MOCK) | gemini | openai | local
# With Gemini, use the same key for both:
#   AI_PROVIDER=gemini
#   EMBEDDING_PROVIDER=gemini
#   GEMINI_API_KEY=            # from https://aistudio.google.com/apikey
#   GEMINI_MODEL=gemini-2.5-flash
# Check it works: python -m app.scripts.ai_check
# After changing EMBEDDING_PROVIDER, re-embed stored policies: python -m app.scripts.reembed

# Store review demo login (set only in the review environment)
# REVIEW_LOGIN_IDENTIFIER=+910000000000
# REVIEW_LOGIN_CODE=123456

# SMS (production): OTP_SENDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Push: log (dev) | fcm
PUSH_SENDER=log
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=   # JSON contents, from the secrets manager

# Rate limiting: memory (dev) | redis (production)
RATE_LIMIT_BACKEND=memory

# Admin dashboard at /admin (unset = disabled; >= 32 chars)
# ADMIN_API_TOKEN=
