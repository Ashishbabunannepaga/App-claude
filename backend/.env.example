# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Production values come from a secrets manager.
ENV=development
DATABASE_URL=postgresql+psycopg://insure:insure@localhost:5432/insure
REDIS_URL=redis://localhost:6379/0
TASKS_EAGER=true

JWT_SECRET=change-me-to-a-long-random-string
OTP_HMAC_SECRET=change-me-too
OTP_SENDER=console

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=        # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via environment or IAM role

# AI: mock | claude | openai   (mock = offline heuristics, development only)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
EMBEDDING_PROVIDER=hashing   # hashing (MOCK) | openai

# Store review demo login (set only in the review environment)
# REVIEW_LOGIN_IDENTIFIER=+910000000000
# REVIEW_LOGIN_CODE=123456
